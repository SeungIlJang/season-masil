# 브라우저에 노출되는 VITE_ 변수에는 운영용 비밀키를 직접 넣지 않는 것이 안전합니다.
# 초기 개발 확인용이며, 실제 배포 전에는 서버 프록시로 옮길 예정입니다.
VITE_TOUR_API_SERVICE_KEY=
VITE_ESHARE_SERVICE_KEY=
VITE_SAFEMAP_SERVICE_KEY=
VITE_SEOUL_OPEN_DATA_KEY=

# Cloudflare Worker URL for production/Android, e.g. https://season-masil-api.example.workers.dev
VITE_API_BASE_URL=

# AdMob: 개발 서버/디버그 앱은 자동으로 Google 테스트 배너를 사용합니다.
# 프로덕션 빌드는 앱에 내장된 운영 배너 ID를 사용하며, 아래 값은 필요할 때만 덮어씁니다.
# VITE_ADMOB_BANNER_ID=ca-app-pub-9017259597860535/8999977836
# VITE_ADMOB_TEST_MODE=true

# Android 프로덕션 AdMob 앱 ID는 필요하면 빌드 시 ADMOB_APP_ID 환경변수/Gradle 속성으로 덮어씁니다.
